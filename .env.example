# PAWS Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.

# ============================================================
# DATABASE (REQUIRED — server-only)
# ============================================================
# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/paws
# Vercel: Provided by Vercel Postgres / Prisma Postgres
DATABASE_URL=

# ============================================================
# SITE URL (REQUIRED — public, used for SEO/canonical URLs)
# ============================================================
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# ============================================================
# ADMIN PIN (REQUIRED — server-only, NEVER expose to browser)
# ============================================================
# Set a secure PIN (4+ digits) for admin dashboard access
# This is validated server-side only — never use NEXT_PUBLIC_ prefix
ADMIN_PIN=
